{
  "name": "bluesky-bridge",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "overrides": {
    "undici": "^7.24.5"
  },
  "scripts": {
    "build": "run-s build:server build:client",
    "build:server": "rm -rf ./dist && tsc",
    "build:client": "node build-client.mjs build",
    "prelint": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src e2e",
    "lint:fix": "eslint --fix src e2e",
    "test:e2e": "npm run build:client && playwright test",
    "test:e2e:ui": "npm run build:client && playwright test --ui",
    "start": "run-p start:server start:client",
    "start:server": "nodemon --watch 'src/**' --ext 'ts' --exec 'tsx src/server.ts'",
    "start:client": "node build-client.mjs watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@alpinejs/morph": "^3.17.5",
    "@alpinejs/persist": "^3.17.5",
